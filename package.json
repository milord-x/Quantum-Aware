{
  "name": "quantum-aware-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only high-entropy secret generation with classical and quantum-aware estimates.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:pages": "npm run build -w @quantum-aware/web",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "dev:web": "npm run dev -w @quantum-aware/web",
    "dev:cli": "npm run dev -w @quantum-aware/cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=20"
  }
}
